FROM dustynv/l4t-pytorch:r36.4.0

# 你之前的国内加速、系统依赖（按需保留即可；不需要再补 CUDA 运行库）
ENV UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ENV UV_EXTRA_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
ENV UV_HTTP_TIMEOUT=300 UV_HTTP_RETRIES=8 UV_HTTP_CONCURRENCY=4

# 仅安装你项目用到的系统包（去掉 torch/CUDA 相关的那堆）
RUN apt-get update && apt-get install -y --no-install-recommends \
      espeak-ng espeak-ng-data libsndfile1 ffmpeg git curl \
      python3.10 python3-venv python3-dev build-essential pkg-config rustc cargo pkg-config libopenblas0 \
      ffmpeg libsndfile1 espeak-ng espeak-ng-data \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/lib/*/espeak-ng-data/* /usr/share/espeak-ng-data/ || true

# 安装 uv（保持你的原做法/脚本不变）
RUN curl -LsSf https://gh-proxy.com/https://github.com/astral-sh/uv/releases/latest/download/uv-installer.sh -o install.sh \
 && sed -i 's#https://github.com#https://gh-proxy.com/https://github.com#g' install.sh \
 && sh install.sh \
 && mv /root/.local/bin/uv /usr/local/bin/ \
 && mv /root/.local/bin/uvx /usr/local/bin/

# 非 root 用户
RUN useradd -m -u 1001 appuser && mkdir -p /app/api/src/models/v1_0 && chown -R appuser:appuser /app
USER appuser
WORKDIR /app

# 依赖：依旧用 uv，但**不要安装 torch**（镜像里已有）
COPY --chown=appuser:appuser pyproject.toml ./pyproject.toml
RUN uv venv --python 3.10 --system-site-packages \
 && uv sync --extra l4t --no-cache --no-install-package torch --no-install-package torchvision --no-install-package torchaudio

# 拷贝代码
COPY --chown=appuser:appuser api ./api
COPY --chown=appuser:appuser web ./web
COPY --chown=appuser:appuser docker/scripts/ ./
RUN chmod +x ./entrypoint.sh

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/api \
    UV_LINK_MODE=copy \
    USE_GPU=true \
    PHONEMIZER_ESPEAK_PATH=/usr/bin \
    PHONEMIZER_ESPEAK_DATA=/usr/share/espeak-ng-data \
    ESPEAK_DATA_PATH=/usr/share/espeak-ng-data \
    DEVICE="l4t" \
    DOWNLOAD_MODEL=true

RUN if [ "$DOWNLOAD_MODEL" = "true" ]; then \
      python download_model.py --output api/src/models/v1_0; \
    fi

CMD ["./entrypoint.sh"]